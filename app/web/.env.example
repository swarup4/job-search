# Must be NEXT_PUBLIC_ — client components call the API from the browser. This is a
# localhost URL, not a secret; never put a key here, since NEXT_PUBLIC_ values ship
# in the bundle. The path suffix matters: src/lib/axiosInstance.js appends nothing.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# The AI tier's own server (`python -m api.main` in ai/) — the Run discovery button.
NEXT_PUBLIC_AI_URL=http://127.0.0.1:8001/api
