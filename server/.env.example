# server owns the LOCAL MongoDB only. Never add MONGODB_ATLAS_URI here —
# the vector store belongs to the ai tier (modules.md, invariant 4).
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=jobpilot

# NFR-4: localhost only.
HOST=127.0.0.1
PORT=8000

# Signing key for the login token. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_TTL_MINUTES=60
# How long a session can sit idle before it has to sign in again. The refresh token
# is spent and replaced on every /account/refresh, so a session in daily use never
# reaches this.
JWT_REFRESH_TTL_DAYS=30

# CORS: the Next dev server and the unpacked extension. Nothing else.
WEB_ORIGIN=http://localhost:3000
EXTENSION_ORIGIN=chrome-extension://

# server -> ai handoff. Redis is the only channel; server never imports ai.
REDIS_URL=redis://127.0.0.1:6379/0

# Where the tailoring agent writes tailored .tex files.
RESUME_OUTPUT_DIR=~/jobpilot/resumes
