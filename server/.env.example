# server owns the LOCAL MongoDB only. Never add MONGODB_ATLAS_URI here —
# the vector store belongs to the ai tier (modules.md, invariant 4).
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=jobpilot

# NFR-4: localhost only.
HOST=127.0.0.1
PORT=8000

# CORS: the Next dev server and the unpacked extension. Nothing else.
WEB_ORIGIN=http://localhost:3000
EXTENSION_ORIGIN=chrome-extension://

# server -> ai handoff. Redis is the only channel; server never imports ai.
REDIS_URL=redis://127.0.0.1:6379/0

# Where the tailoring agent writes tailored .tex files.
RESUME_OUTPUT_DIR=~/jobpilot/resumes
