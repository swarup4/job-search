      "post": {
        "tags": [
          "capture"
        ],
        "summary": "Process Capture",
        "operationId": "process_capture_api_capture__description_id__post",
        "parameters": [
          {
            "name": "description_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Description Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
