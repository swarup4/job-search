    "/api/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Read Settings",
        "operationId": "read_settings_api_settings_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ]
