  "paths": {
    "/api/runs/discovery/start": {
      "post": {
        "tags": [
          "discovery"
        ],
        "summary": "Start Discovery",
        "operationId": "start_discovery_api_runs_discovery_start_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/DiscoveryRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        }
      }
    },
    "/api/runs/discovery/events": {
      "get": {
        "tags": [
          "discovery"
        ],
        "summary": "Discovery Events",
        "description": "Your latest run: `run_started` (the run itself), `company_done` as each company\nfinishes, then `run_done`. 204 when you have none.",
        "operationId": "discovery_events_api_runs_discovery_events_get",
        "parameters": [
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ]
      }
    },
    "/api/runs/analysis/start": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Start Analysis",
        "operationId": "start_analysis_api_runs_analysis_start_post",
        "parameters": [
