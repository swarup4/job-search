    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get"
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "jobIds": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 50,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Jobids"
          },
          "newest": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 50.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Newest"
          }
        },
        "type": "object",
        "title": "AnalysisRequest",
        "description": "Exactly one of the two: specific jobs, or the newest `newest` unscored ones."
      },
      "DiscoveryRequest": {
        "properties": {
          "limit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 500.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          }
        },
        "type": "object",
        "title": "DiscoveryRequest",
        "description": "`limit` stops the run once that many new jobs are stored. Omitted, every enabled\ncompany is scraped in full, filtered by your Search targets."
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8001",
      "description": "local \u2014 ai/main.py"
    }
  ]
}
