            }
          }
        ]
      }
    },
    "/api/tailoring/{job_id}": {
      "post": {
        "tags": [
          "tailoring"
        ],
        "summary": "Tailor",
        "operationId": "tailor_api_tailoring__job_id__post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "authorization",
