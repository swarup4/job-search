                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          }
        }
      }
    },
    "/api/runs/analysis/events": {
      "get": {
        "tags": [
          "analysis"
        ],
        "summary": "Analysis Events",
        "description": "The caller's latest run as a stream: every event so far, then each new one,\nclosing after `run_done`. `Last-Event-ID` resumes after a dropped connection.",
        "operationId": "analysis_events_api_runs_analysis_events_get",
        "parameters": [
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ]
      }
    },
    "/api/runs/scoring/start": {
      "post": {
        "tags": [
