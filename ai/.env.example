# Defaults live beside the code that reads each value — set only what you change.

# Qwen3 hosted, via the HF router. Pin the provider — `strict: true` support varies
# between them, and an unpinned router drops it silently.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=hf_replace-me
LLM_MODEL=Qwen/Qwen3-32B:nscale
LLM_TIMEOUT=240
LLM_ATTEMPTS=3
LLM_DISABLE_THINKING=true

JOBPILOT_API_URL=http://127.0.0.1:8000/api

# Embeddings for the near-miss check. Key: https://dash.voyageai.com/
VOYAGE_API_KEY=replace-me
VOYAGE_EMBED_MODEL=voyage-4-lite
VOYAGE_EMBED_DIMS=1024

# Second pass for retrieval (P6-05). A cross-encoder: it reads the query and the
# chunk together, so it sorts the top ~50 far better than a cosine and is far too
# expensive to run over the whole profile.
VOYAGE_RERANK_MODEL=rerank-2.5-lite

# Calibrated on voyage-4-lite (related 0.368-0.544, unrelated 0.219-0.324).
# Re-run `python rag/embeddings.py` and retune if the embedding model changes.
NEAR_MISS_THRESHOLD=0.35
