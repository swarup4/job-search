# Defaults live beside the code that reads each value — set only what you change.
# Everything here runs on this machine: no key, no account, no hosted service.

# Generation: an open-weights model served by Ollama over its OpenAI-compatible API.
# Pull the model first (`ollama pull <model>`). It must honour a strict JSON schema.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
# Ollama ignores the key; the header still has to carry something.
LLM_API_KEY=ollama
LLM_TIMEOUT=240
LLM_ATTEMPTS=3
LLM_DISABLE_THINKING=true
# The context window the model server gives the model, not the model's maximum. Ollama
# ignores a per-request size on this API, so it must equal `num_ctx` in the Modelfile.
LLM_NUM_CTX=16384

# One step on its own model — each falls back to the LLM_* value above when unset.
# MATCH is the requirement-vs-profile comparison, BRIEF reads a posting, INVENTORY
# reads the profile.
# MATCH_LLM_MODEL=
# BRIEF_LLM_MODEL=
# INVENTORY_LLM_MODEL=

JOBPILOT_API_URL=http://127.0.0.1:8000/api

# This tier's own server (`python -m api.main`) — the dashboard's Run discovery button.
# Loopback only, like the API server.
AI_HOST=127.0.0.1
AI_PORT=8001

# Embeddings for the near-miss check: an open-weights model on the same Ollama
# (`ollama pull bge-m3`). EMBED_DIMS is what the model returns; a model of another
# size is refused rather than stored.
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
EMBED_DIMS=1024

# The cosine at or above which a profile line is offered as a near miss. It belongs to
# one embedding model, and this value is provisional for bge-m3 (see rag/embeddings.py).
# Run `python -m rag.embeddings` and retune whenever EMBED_MODEL changes.
NEAR_MISS_THRESHOLD=0.53

# How many jobs one scoring run (the header's Refresh) scores. It takes only jobs inside
# your saved Search targets, newest first, and leaves the rest for the next run.
SCORING_MAX_JOBS=50

# Career-page scraping (docs/08). A run searches with the Search targets saved on
# Settings (/api/preference); these three are only the fallbacks for an empty field
# and for `python -m sources.workday`'s dry run. Titles are word-matched.
SCRAPE_TITLES=AI,GenAI,Generative,LLM,Agentic,Machine Learning,ML
SCRAPE_LOCATIONS=India
SCRAPE_USER_AGENT=JobPilot/1.0 (personal job-search assistant)
SCRAPE_MAX_PER_HOST=2
SCRAPE_WORKDAY_MAX_PAGES=5
